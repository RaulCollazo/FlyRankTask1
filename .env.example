DATABASE_URL=postgres://postgres:dev@localhost:5432/tasks
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_key


# LLM Configuration (W7)
LLM_PROVIDER=stub  # options: stub, openrouter, openai
LLM_API_KEY=
LLM_MODEL=google/gemma-3-12b-it:free
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=0.5
LLM_KILL_SWITCH=false  # set to true to disable LLM calls
LLM_COST_PER_1K_TOKENS_IN=0.0
LLM_COST_PER_1K_TOKENS_OUT=0.0
